<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/w_bg" android:padding="14dp">
    <LinearLayout android:id="@+id/w_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="6dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="To-do" android:textColor="@color/w_ink" android:textSize="17sp" android:textStyle="bold"/>
        <TextView android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_mut" android:textSize="13sp"/>
    </LinearLayout>
    <ListView android:id="@+id/w_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@color/w_line" android:dividerHeight="1dp"/>
    <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="@color/w_mut" android:textSize="14sp" android:text="Nothing on today’s list"/>
</LinearLayout>
