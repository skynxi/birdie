<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/c_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/w_bg" android:padding="14dp" android:gravity="center_vertical">
    <TextView android:id="@+id/c_dlabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Next date" android:textColor="@color/w_mut" android:textSize="12sp"/>
    <TextView android:id="@+id/c_dname" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/w_ink" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/c_dwhen" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/w_acc" android:textSize="13sp" android:maxLines="1"/>
    <View android:id="@+id/c_sep" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/w_line" android:layout_marginTop="10dp" android:layout_marginBottom="10dp"/>
    <TextView android:id="@+id/c_flabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Next follow-up" android:textColor="@color/w_mut" android:textSize="12sp"/>
    <TextView android:id="@+id/c_fname" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/w_ink" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/c_fwhen" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/w_mut" android:textSize="13sp" android:maxLines="1"/>
</LinearLayout>
